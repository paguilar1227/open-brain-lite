{
  "name": "open-brain-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:watch": "vitest",
    "migrate": "psql $DATABASE_URL -f ../migrations/001_schema.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@azure/monitor-opentelemetry": "^1.18.1",
    "@azure/storage-blob": "^12.26.0",
    "@github/copilot-sdk": "1.0.22",
    "@google/generative-ai": "^0.24.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^0.19.0",
    "@mendable/firecrawl-js": "^4.18.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mozilla/readability": "0.6.0",
    "@open-brain/shared": "*",
    "@openai/codex-sdk": "0.162.1",
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "^16.4.7",
    "hono": "^4.12.25",
    "linkedom": "0.18.13",
    "mammoth": "1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
