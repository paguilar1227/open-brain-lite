# backend/.env.example
#
# Copy to backend/.env and fill in values for local dev. The real .env is
# gitignored. There are two recipes — pick one.
#
# ---------------------------------------------------------------------------
# Recipe A — Stub mode (recommended for UI iteration + integration tests)
# ---------------------------------------------------------------------------
# Zero upstream API spend. All LLM + embedding calls go through deterministic
# in-memory fakes (backend/src/providers/stub.ts). Postgres + Azurite are
# real services from `npm run compose:up`.

LLM_PROVIDER=stub
DATABASE_URL=postgres://openbrain:openbrain@localhost:5434/openbrain
OPEN_BRAIN_API_KEY=local-dev-key-not-secret

# Azurite (local Blob emulator). The connection string below is the standard
# Azurite well-known account/key plus the host port we expose in compose (10010).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10010/devstoreaccount1;
AZURE_STORAGE_CONTAINER=open-brain-content

PORT=3001
NODE_ENV=development
TIMEZONE=America/Chicago

# In stub mode these can be empty / placeholder. Required only when you flip
# LLM_PROVIDER=real for quality validation.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
FIRECRAWL_API_KEY=
SUPADATA_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# ---------------------------------------------------------------------------
# Recipe B — Real mode (quality validation, prompt regression checks)
# ---------------------------------------------------------------------------
# Set LLM_PROVIDER=real (or omit it — real is the default). Then fill in the
# upstream keys above. Each ingest costs roughly $0.001-$0.05 in API spend
# depending on size.
