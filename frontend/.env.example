# frontend/.env.example
#
# Copy to frontend/.env.local for local dev. The .env.local is gitignored.
# Vite exposes any var prefixed with VITE_ to the client bundle.

# The Bearer token sent on every /api/* request. Must match
# OPEN_BRAIN_API_KEY in backend/.env. The default below matches the
# stub-mode default in backend/.env.example, so a fresh `npm run dev:up`
# Just Works without further config.
VITE_OPEN_BRAIN_API_KEY=local-dev-key-not-secret
